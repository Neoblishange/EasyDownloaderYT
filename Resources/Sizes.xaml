<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <sys:Double x:Key="FontSize.Title">40</sys:Double>
    <sys:Double x:Key="FontSize.Large">20</sys:Double>
    <sys:Double x:Key="FontSize.Body">18</sys:Double>
    <sys:Double x:Key="FontSize.Small">16</sys:Double>
    <sys:Double x:Key="FontSize.ExtraSmall">14</sys:Double>
</ResourceDictionary>