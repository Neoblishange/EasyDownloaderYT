<Window x:Class="EasyDownloaderYT.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:notifications="clr-namespace:EasyDownloaderYT.Views.Notifications"
        Title="EasyDownloaderYT"
        Icon="/Resources/Icons/EasyDownloaderYT.ico"
        Height="850"
        Width="1100"
        ResizeMode="CanMinimize"
        MinHeight="660"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFB"
        FontFamily="{DynamicResource App.Font}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Window.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/Views/Queue/DownloadQueueItemTemplate.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#1E40AF"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Large}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2D3748"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#000000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#C9CDD4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LangItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Small}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="10,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E5E7EB"/>
                                <Setter Property="Foreground" Value="#111827"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#111827"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LangList" TargetType="ListBox">
            <Setter Property="ItemContainerStyle" Value="{StaticResource LangItem}"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Small}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#D1D5DB"
                                BorderThickness="1"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#D1D5DB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="#4B5563"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Small}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E5E7EB"/>
                                <Setter Property="Foreground" Value="#111827"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QueueCancelButton" TargetType="Button">
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="Foreground" Value="#B91C1C"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#FECACA"
                                BorderThickness="1"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FEE2E2"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#F87171"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FECACA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QueueRetryButton" TargetType="Button">
            <Setter Property="Background" Value="#ECFDF5"/>
            <Setter Property="Foreground" Value="#047857"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#A7F3D0"
                                BorderThickness="1"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#D1FAE5"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#6EE7B7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#A7F3D0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CleanTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="14,0"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="0,10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#111827"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentedList" TargetType="ListBox">
            <Setter Property="ItemContainerStyle" Value="{StaticResource SegmentItem}"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="#EEF0F3"
                                CornerRadius="10"
                                Padding="4">
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThinProgressBar" TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track"
                                    Background="#D1D5DB"
                                    CornerRadius="3"/>
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="3"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlaceholderText" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="16,0,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=UrlTextBox}" Value="">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

      </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="420"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="560" Margin="30,36,30,32">
            <Grid>
                <TextBlock Text="EasyDownloaderYT"
                           FontSize="{DynamicResource FontSize.Small}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentBrush}"/>

                <ListBox x:Name="LanguageList"
                         HorizontalAlignment="Right"
                         SelectedValuePath="Code"
                         DisplayMemberPath="NativeName"
                         Style="{StaticResource LangList}"/>
            </Grid>

            <TextBlock Text="{DynamicResource Hero.Title}"
                       FontSize="{DynamicResource FontSize.Title}"
                       FontWeight="SemiBold"
                       Foreground="#111827"
                       LineHeight="56"
                       LineStackingStrategy="BlockLineHeight"
                       TextWrapping="Wrap"
                       Margin="0,24,0,0"/>

            <TextBlock Text="{DynamicResource Hero.Subtitle}"
                       FontSize="{DynamicResource FontSize.Body}"
                       Foreground="#4B5563"
                       TextWrapping="Wrap"
                       Margin="0,14,0,0"/>

            <TextBlock Text="{DynamicResource Label.Link}"
                       FontSize="{DynamicResource FontSize.Small}"
                       FontWeight="SemiBold"
                       Foreground="#374151"
                       Margin="0,44,0,8"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox x:Name="UrlTextBox"
                             Height="48"
                             Style="{StaticResource CleanTextBox}"/>
                    <TextBlock Text="https://..."
                               Style="{StaticResource PlaceholderText}"/>
                </Grid>

                <Button x:Name="PasteButton"
                        Grid.Column="1"
                        Content="{DynamicResource Button.Paste}"
                        IsEnabled="{Binding CanInteract}"
                        MinWidth="84"
                        Height="48"
                        Margin="10,0,0,0"
                        Padding="14,0"
                        Style="{StaticResource OutlineButton}"/>
            </Grid>

            <TextBlock Text="{DynamicResource Label.Format}"
                       FontSize="{DynamicResource FontSize.ExtraSmall}"
                       FontWeight="SemiBold"
                       Foreground="#374151"
                       Margin="0,26,0,8"/>

            <ListBox x:Name="FormatComboBox"
                     SelectedIndex="0"
                     Style="{StaticResource SegmentedList}">
                <ListBoxItem Content="{DynamicResource Format.Video}"/>
                <ListBoxItem Content="{DynamicResource Format.AudioMp3}"/>
                <ListBoxItem Content="{DynamicResource Format.AudioWav}"/>
            </ListBox>

            <Button x:Name="DownloadButton"
                    Content="{DynamicResource Button.Download}"
                    IsEnabled="{Binding CanInteract}"
                    Height="54"
                    Margin="0,34,0,0"
                    Style="{StaticResource PrimaryButton}"/>

            <Border BorderBrush="#D1D5DB"
                    BorderThickness="0,1,0,0"
                    Margin="0,36,0,0"
                    Padding="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="OpenFolderButton"
                            Grid.Column="0"
                            Content="{DynamicResource Button.OpenFolder}"
                            HorizontalAlignment="Left"
                            Margin="-12,0,0,0"
                            Style="{StaticResource LinkButton}"/>

                    <Button x:Name="UpdateButton"
                            Grid.Column="1"
                            Content="{DynamicResource Button.Update}"
                            IsEnabled="{Binding CanUpdate}"
                            HorizontalAlignment="Right"
                            Margin="0,0,-12,0"
                            Style="{StaticResource LinkButton}"/>
                </Grid>
            </Border>
        </StackPanel>
        </ScrollViewer>

        <notifications:NotificationBanner x:Name="NotificationBanner"
                                          Grid.Row="1"
                                          Grid.Column="0"
                                          Margin="24,0,24,16"/>

        <Border Grid.Column="1"
                Grid.RowSpan="2"
                Background="#F3F4F6"
                BorderBrush="#D1D5DB"
                BorderThickness="1,0,0,0"
                Padding="18,28,18,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Queue.Title}"
                                   FontSize="{DynamicResource FontSize.Body}"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="{DynamicResource Queue.Clear}"
                                ToolTip="{DynamicResource Queue.Clear}"
                                Command="{Binding ClearFinishedItemsCommand}"
                                MinWidth="64"
                                Height="30"
                                Padding="10,0"
                                Style="{StaticResource OutlineButton}"/>
                    </Grid>
                    <TextBlock x:Name="QueueEmptyTextBlock"
                               Text="{DynamicResource Queue.Empty}"
                               Visibility="{Binding IsQueueEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"
                               FontSize="{DynamicResource FontSize.Small}"
                               Foreground="#6B7280"
                               Margin="0,12,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              Margin="0,16,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources>
                        <Style TargetType="{x:Type ScrollBar}">
                            <Setter Property="Width" Value="8"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                                        <Grid Background="Transparent"
                                              Margin="2,0">
                                            <Track x:Name="PART_Track"
                                                   IsDirectionReversed="True">
                                                <Track.Thumb>
                                                    <Thumb>
                                                        <Thumb.Template>
                                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                                <Border x:Name="ThumbBorder"
                                                                        Background="#9CA3AF"
                                                                        CornerRadius="4"
                                                                        Margin="1"/>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="ThumbBorder"
                                                                                Property="Background"
                                                                                Value="#6B7280"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsDragging" Value="True">
                                                                        <Setter TargetName="ThumbBorder"
                                                                                Property="Background"
                                                                                Value="{DynamicResource AccentBrush}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                    </Thumb>
                                                </Track.Thumb>
                                            </Track>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ScrollViewer.Resources>
                    <ItemsControl ItemsSource="{Binding DownloadQueue}"
                                  ItemTemplate="{StaticResource DownloadQueueItemTemplate}">
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>