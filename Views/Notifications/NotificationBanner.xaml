<UserControl x:Class="EasyDownloaderYT.Views.Notifications.NotificationBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="AppNotification"
            Visibility="Collapsed"
            Background="#ECFDF5"
            BorderBrush="#A7F3D0"
            BorderThickness="1"
            CornerRadius="10"
            Padding="16,16"
            PreviewMouseDown="AppNotification_PreviewMouseDown">
        <TextBlock x:Name="NotificationText"
                   Foreground="#047857"
                   FontSize="{DynamicResource FontSize.Small}"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"/>
    </Border>
</UserControl>
